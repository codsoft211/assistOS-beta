{
  "moduleId": "purchasing",
  "displayName": "Purchasing",
  "tables": {
    "suppliers": {
      "tableName": "suppliers",
      "description": "Supplier records",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "name", "type": "text", "nullable": false },
        { "name": "trading_name", "type": "text", "nullable": true },
        { "name": "nif", "type": "varchar(20)", "nullable": true },
        { "name": "email", "type": "text", "nullable": true },
        { "name": "phone", "type": "text", "nullable": true },
        { "name": "address", "type": "text", "nullable": true },
        { "name": "city", "type": "text", "nullable": true },
        { "name": "postal_code", "type": "text", "nullable": true },
        { "name": "country", "type": "text", "nullable": true, "default": "'Portugal'" },
        { "name": "iban", "type": "text", "nullable": true },
        { "name": "payment_terms", "type": "integer", "nullable": true, "default": "30" },
        { "name": "status", "type": "text", "nullable": false, "default": "'active'" },
        { "name": "category", "type": "text", "nullable": true },
        { "name": "rating", "type": "integer", "nullable": true },
        { "name": "notes", "type": "text", "nullable": true },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_by", "type": "uuid", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "suppliers_name_idx", "columns": ["name"] },
        { "name": "suppliers_nif_idx", "columns": ["nif"] }
      ]
    },
    "purchase_orders": {
      "tableName": "purchase_orders",
      "description": "Purchase orders",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "po_number", "type": "text", "nullable": false },
        { "name": "supplier_id", "type": "uuid", "nullable": true },
        { "name": "supplier_name", "type": "text", "nullable": true },
        { "name": "order_date", "type": "date", "nullable": false },
        { "name": "expected_date", "type": "date", "nullable": true },
        { "name": "status", "type": "text", "nullable": false, "default": "'draft'" },
        { "name": "currency", "type": "text", "nullable": false, "default": "'EUR'" },
        { "name": "subtotal", "type": "decimal(12,2)", "nullable": false, "default": "'0'" },
        { "name": "tax_amount", "type": "decimal(12,2)", "nullable": false, "default": "'0'" },
        { "name": "total_amount", "type": "decimal(12,2)", "nullable": false, "default": "'0'" },
        { "name": "shipping_address", "type": "text", "nullable": true },
        { "name": "notes", "type": "text", "nullable": true },
        { "name": "approved_by", "type": "uuid", "nullable": true },
        { "name": "approved_at", "type": "timestamp", "nullable": true },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_by", "type": "uuid", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "purchase_orders_supplier_idx", "columns": ["supplier_id"] },
        { "name": "purchase_orders_status_idx", "columns": ["status"] }
      ]
    },
    "purchase_order_lines": {
      "tableName": "purchase_order_lines",
      "description": "Purchase order line items",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "order_id", "type": "uuid", "nullable": false },
        { "name": "line_number", "type": "integer", "nullable": false },
        { "name": "product_id", "type": "uuid", "nullable": true },
        { "name": "description", "type": "text", "nullable": false },
        { "name": "quantity", "type": "decimal(10,3)", "nullable": false },
        { "name": "unit", "type": "text", "nullable": false, "default": "'un'" },
        { "name": "unit_price", "type": "decimal(12,4)", "nullable": false },
        { "name": "tax_rate", "type": "decimal(5,2)", "nullable": false },
        { "name": "total_amount", "type": "decimal(12,2)", "nullable": false },
        { "name": "received_quantity", "type": "decimal(10,3)", "nullable": true, "default": "'0'" },
        { "name": "metadata", "type": "jsonb", "nullable": true }
      ],
      "indexes": [
        { "name": "po_lines_order_idx", "columns": ["order_id"] }
      ]
    },
    "purchase_requisitions": {
      "tableName": "purchase_requisitions",
      "description": "Purchase requisition requests",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "requisition_number", "type": "text", "nullable": false },
        { "name": "title", "type": "text", "nullable": false },
        { "name": "description", "type": "text", "nullable": true },
        { "name": "requester_id", "type": "uuid", "nullable": false },
        { "name": "department", "type": "text", "nullable": true },
        { "name": "priority", "type": "text", "nullable": false, "default": "'normal'" },
        { "name": "needed_by", "type": "date", "nullable": true },
        { "name": "status", "type": "text", "nullable": false, "default": "'draft'" },
        { "name": "estimated_amount", "type": "decimal(12,2)", "nullable": true },
        { "name": "approved_by", "type": "uuid", "nullable": true },
        { "name": "approved_at", "type": "timestamp", "nullable": true },
        { "name": "notes", "type": "text", "nullable": true },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "pr_status_idx", "columns": ["status"] },
        { "name": "pr_requester_idx", "columns": ["requester_id"] }
      ]
    },
    "goods_receipts": {
      "tableName": "goods_receipts",
      "description": "Goods receipt records",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "receipt_number", "type": "text", "nullable": false },
        { "name": "purchase_order_id", "type": "uuid", "nullable": true },
        { "name": "supplier_id", "type": "uuid", "nullable": true },
        { "name": "receipt_date", "type": "date", "nullable": false },
        { "name": "status", "type": "text", "nullable": false, "default": "'draft'" },
        { "name": "warehouse_id", "type": "uuid", "nullable": true },
        { "name": "notes", "type": "text", "nullable": true },
        { "name": "received_by", "type": "uuid", "nullable": true },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "gr_po_idx", "columns": ["purchase_order_id"] },
        { "name": "gr_status_idx", "columns": ["status"] }
      ]
    }
  }
}
