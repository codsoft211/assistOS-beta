{
  "moduleId": "crm",
  "displayName": "CRM",
  "tables": {
    "clients": {
      "tableName": "clients",
      "description": "Customer/client records",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "name", "type": "text", "nullable": false },
        { "name": "trading_name", "type": "text", "nullable": true },
        { "name": "nif", "type": "varchar(20)", "nullable": true },
        { "name": "email", "type": "text", "nullable": true },
        { "name": "phone", "type": "text", "nullable": true },
        { "name": "address", "type": "text", "nullable": true },
        { "name": "city", "type": "text", "nullable": true },
        { "name": "postal_code", "type": "text", "nullable": true },
        { "name": "country", "type": "text", "nullable": true, "default": "'Portugal'" },
        { "name": "client_type", "type": "text", "nullable": true },
        { "name": "status", "type": "text", "nullable": false, "default": "'active'" },
        { "name": "credit_limit", "type": "decimal(12,2)", "nullable": true },
        { "name": "payment_terms", "type": "integer", "nullable": true, "default": "30" },
        { "name": "notes", "type": "text", "nullable": true },
        { "name": "tags", "type": "jsonb", "nullable": true },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_by", "type": "uuid", "nullable": true, "foreignKey": { "table": "users", "column": "id" } },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "clients_name_idx", "columns": ["name"] },
        { "name": "clients_nif_idx", "columns": ["nif"] },
        { "name": "clients_status_idx", "columns": ["status"] }
      ]
    },
    "entities": {
      "tableName": "entities",
      "description": "Generic entity records (contacts, companies)",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "entity_type", "type": "text", "nullable": false },
        { "name": "name", "type": "text", "nullable": false },
        { "name": "email", "type": "text", "nullable": true },
        { "name": "phone", "type": "text", "nullable": true },
        { "name": "company", "type": "text", "nullable": true },
        { "name": "position", "type": "text", "nullable": true },
        { "name": "address", "type": "text", "nullable": true },
        { "name": "notes", "type": "text", "nullable": true },
        { "name": "tags", "type": "jsonb", "nullable": true },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "entities_type_idx", "columns": ["entity_type"] },
        { "name": "entities_name_idx", "columns": ["name"] }
      ]
    },
    "opportunities": {
      "tableName": "opportunities",
      "description": "Sales opportunities and deals",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "title", "type": "text", "nullable": false },
        { "name": "client_id", "type": "uuid", "nullable": true, "foreignKey": { "table": "clients", "column": "id" } },
        { "name": "entity_id", "type": "uuid", "nullable": true, "foreignKey": { "table": "entities", "column": "id" } },
        { "name": "stage", "type": "text", "nullable": false, "default": "'lead'" },
        { "name": "probability", "type": "integer", "nullable": true },
        { "name": "value", "type": "decimal(15,2)", "nullable": true },
        { "name": "currency", "type": "text", "nullable": false, "default": "'EUR'" },
        { "name": "expected_close_date", "type": "date", "nullable": true },
        { "name": "source", "type": "text", "nullable": true },
        { "name": "description", "type": "text", "nullable": true },
        { "name": "owner_id", "type": "uuid", "nullable": true, "foreignKey": { "table": "users", "column": "id" } },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "closed_at", "type": "timestamp", "nullable": true },
        { "name": "closed_reason", "type": "text", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "opportunities_client_idx", "columns": ["client_id"] },
        { "name": "opportunities_stage_idx", "columns": ["stage"] },
        { "name": "opportunities_owner_idx", "columns": ["owner_id"] }
      ]
    },
    "activities": {
      "tableName": "activities",
      "description": "CRM activities (calls, meetings, tasks)",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "activity_type", "type": "text", "nullable": false },
        { "name": "subject", "type": "text", "nullable": false },
        { "name": "description", "type": "text", "nullable": true },
        { "name": "client_id", "type": "uuid", "nullable": true, "foreignKey": { "table": "clients", "column": "id" } },
        { "name": "entity_id", "type": "uuid", "nullable": true, "foreignKey": { "table": "entities", "column": "id" } },
        { "name": "opportunity_id", "type": "uuid", "nullable": true, "foreignKey": { "table": "opportunities", "column": "id" } },
        { "name": "due_date", "type": "timestamp", "nullable": true },
        { "name": "completed_at", "type": "timestamp", "nullable": true },
        { "name": "status", "type": "text", "nullable": false, "default": "'pending'" },
        { "name": "priority", "type": "text", "nullable": true, "default": "'normal'" },
        { "name": "assigned_to", "type": "uuid", "nullable": true, "foreignKey": { "table": "users", "column": "id" } },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_by", "type": "uuid", "nullable": true, "foreignKey": { "table": "users", "column": "id" } },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "activities_type_idx", "columns": ["activity_type"] },
        { "name": "activities_client_idx", "columns": ["client_id"] },
        { "name": "activities_status_idx", "columns": ["status"] }
      ]
    },
    "activity_feed": {
      "tableName": "activity_feed",
      "description": "Activity timeline and feed",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "activity_type", "type": "text", "nullable": false },
        { "name": "entity_type", "type": "text", "nullable": false },
        { "name": "entity_id", "type": "uuid", "nullable": false },
        { "name": "title", "type": "text", "nullable": false },
        { "name": "description", "type": "text", "nullable": true },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "user_id", "type": "uuid", "nullable": true, "foreignKey": { "table": "users", "column": "id" } },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "activity_feed_entity_idx", "columns": ["entity_type", "entity_id"] },
        { "name": "activity_feed_created_at_idx", "columns": ["created_at"] }
      ]
    }
  }
}
