import { useQuery } from '@tanstack/react-query';
import { Button } from '@/components/ui/button';
import { Plus } from 'lucide-react';
import { Link } from 'wouter';

export default function {{pascalEntityName}}List() {
  const { data: items, isLoading } = useQuery({
    queryKey: ['/api/{{routePath}}']
  });

  if (isLoading) return <div>Loading...</div>;

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-2xl font-bold">{{entityLabel}}</h1>
        <Link href="/{{routePath}}/new">
          <Button data-testid="button-create-{{entityName}}">
            <Plus className="w-4 h-4 mr-2" />
            Criar {{entityLabel}}
          </Button>
        </Link>
      </div>

      <div className="grid gap-4">
        {items?.map((item: any) => (
          <div key={item.id} className="border rounded p-4" data-testid={`card-{{entityName}}-${item.id}`}>
            <h3 className="font-semibold">{item.id}</h3>
            <Link href={`/{{routePath}}/${item.id}`}>
              <Button variant="outline" size="sm">Ver Detalhes</Button>
            </Link>
          </div>
        ))}
      </div>
    </div>
  );
}
