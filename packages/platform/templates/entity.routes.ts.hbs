import { Router } from 'express';
import { db } from '../db';
import { {{tableName}}, insert{{pascalEntityName}}Schema } from '../../shared/schema';
import { eq, and } from 'drizzle-orm';
import { requireAuth } from '../middleware/auth';

const router = Router();

// GET /api/{{routePath}} - List all
router.get('/{{routePath}}', requireAuth, async (req, res) => {
  try {
    const items = await db
      .select()
      .from({{tableName}})
      .where(eq({{tableName}}.tenantId, req.user!.tenantId));
    res.json(items);
  } catch (error) {
    res.status(500).json({ error: 'Failed to fetch {{entityName}}' });
  }
});

// POST /api/{{routePath}} - Create
router.post('/{{routePath}}', requireAuth, async (req, res) => {
  try {
    const validated = insert{{pascalEntityName}}Schema.parse(req.body);
    const [created] = await db
      .insert({{tableName}})
      .values({ ...validated, tenantId: req.user!.tenantId })
      .returning();
    res.status(201).json(created);
  } catch (error) {
    res.status(400).json({ error: 'Validation failed' });
  }
});

// PUT /api/{{routePath}}/:id - Update
router.put('/{{routePath}}/:id', requireAuth, async (req, res) => {
  try {
    const validated = insert{{pascalEntityName}}Schema.parse(req.body);
    const [updated] = await db
      .update({{tableName}})
      .set(validated)
      .where(and(
        eq({{tableName}}.id, req.params.id),
        eq({{tableName}}.tenantId, req.user!.tenantId)
      ))
      .returning();
    res.json(updated);
  } catch (error) {
    res.status(400).json({ error: 'Update failed' });
  }
});

// DELETE /api/{{routePath}}/:id - Delete
router.delete('/{{routePath}}/:id', requireAuth, async (req, res) => {
  try {
    await db
      .delete({{tableName}})
      .where(and(
        eq({{tableName}}.id, req.params.id),
        eq({{tableName}}.tenantId, req.user!.tenantId)
      ));
    res.status(204).send();
  } catch (error) {
    res.status(500).json({ error: 'Delete failed' });
  }
});

export default router;
