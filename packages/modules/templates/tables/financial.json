{
  "moduleId": "financial",
  "displayName": "Financial",
  "tables": {
    "invoices": {
      "tableName": "invoices",
      "description": "Customer and supplier invoices",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "invoice_type", "type": "text", "nullable": false, "default": "'receivable'" },
        { "name": "invoice_number", "type": "text", "nullable": false },
        { "name": "client_id", "type": "uuid", "nullable": true },
        { "name": "client_name", "type": "text", "nullable": true },
        { "name": "client_nif", "type": "text", "nullable": true },
        { "name": "supplier_id", "type": "uuid", "nullable": true },
        { "name": "supplier_name", "type": "text", "nullable": true },
        { "name": "issue_date", "type": "timestamp", "nullable": false },
        { "name": "due_date", "type": "timestamp", "nullable": true },
        { "name": "status", "type": "text", "nullable": false, "default": "'draft'" },
        { "name": "payment_status", "type": "text", "nullable": false, "default": "'pending'" },
        { "name": "payment_method", "type": "text", "nullable": true },
        { "name": "currency", "type": "text", "nullable": false, "default": "'EUR'" },
        { "name": "subtotal", "type": "decimal(12,2)", "nullable": false, "default": "'0'" },
        { "name": "tax_amount", "type": "decimal(12,2)", "nullable": false, "default": "'0'" },
        { "name": "total_amount", "type": "decimal(12,2)", "nullable": false, "default": "'0'" },
        { "name": "paid_amount", "type": "decimal(12,2)", "nullable": false, "default": "'0'" },
        { "name": "document_type", "type": "text", "nullable": true },
        { "name": "fiscal_year", "type": "integer", "nullable": true },
        { "name": "notes", "type": "text", "nullable": true },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_by", "type": "uuid", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "invoices_type_idx", "columns": ["invoice_type"] },
        { "name": "invoices_status_idx", "columns": ["status"] }
      ]
    },
    "invoice_lines": {
      "tableName": "invoice_lines",
      "description": "Invoice line items",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "invoice_id", "type": "uuid", "nullable": false },
        { "name": "line_number", "type": "integer", "nullable": false },
        { "name": "product_id", "type": "uuid", "nullable": true },
        { "name": "description", "type": "text", "nullable": false },
        { "name": "quantity", "type": "decimal(10,3)", "nullable": false },
        { "name": "unit", "type": "text", "nullable": false, "default": "'un'" },
        { "name": "unit_price", "type": "decimal(12,4)", "nullable": false },
        { "name": "tax_rate", "type": "decimal(5,2)", "nullable": false },
        { "name": "total_amount", "type": "decimal(12,2)", "nullable": false },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "invoice_lines_invoice_idx", "columns": ["invoice_id"] }
      ]
    },
    "payments": {
      "tableName": "payments",
      "description": "Payment records",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "payment_number", "type": "text", "nullable": false },
        { "name": "payment_type", "type": "text", "nullable": false },
        { "name": "payment_date", "type": "timestamp", "nullable": false },
        { "name": "entity_type", "type": "text", "nullable": false },
        { "name": "entity_id", "type": "uuid", "nullable": true },
        { "name": "bank_account_id", "type": "uuid", "nullable": true },
        { "name": "payment_method", "type": "text", "nullable": false },
        { "name": "currency", "type": "text", "nullable": false, "default": "'EUR'" },
        { "name": "amount", "type": "decimal(12,2)", "nullable": false },
        { "name": "status", "type": "text", "nullable": false, "default": "'pending'" },
        { "name": "notes", "type": "text", "nullable": true },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_by", "type": "uuid", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "payments_type_idx", "columns": ["payment_type"] },
        { "name": "payments_status_idx", "columns": ["status"] }
      ]
    },
    "bank_accounts": {
      "tableName": "bank_accounts",
      "description": "Bank account records",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "name", "type": "text", "nullable": false },
        { "name": "bank_name", "type": "text", "nullable": false },
        { "name": "iban", "type": "text", "nullable": true },
        { "name": "swift", "type": "text", "nullable": true },
        { "name": "currency", "type": "text", "nullable": false, "default": "'EUR'" },
        { "name": "current_balance", "type": "decimal(15,2)", "nullable": false, "default": "'0'" },
        { "name": "is_active", "type": "boolean", "nullable": false, "default": "true" },
        { "name": "metadata", "type": "jsonb", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "bank_accounts_name_idx", "columns": ["name"] }
      ]
    },
    "payables": {
      "tableName": "payables",
      "description": "Accounts payable records",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "primaryKey": true, "default": "gen_random_uuid()" },
        { "name": "invoice_id", "type": "uuid", "nullable": true },
        { "name": "supplier_id", "type": "uuid", "nullable": true },
        { "name": "due_date", "type": "date", "nullable": false },
        { "name": "amount", "type": "decimal(12,2)", "nullable": false },
        { "name": "paid_amount", "type": "decimal(12,2)", "nullable": false, "default": "'0'" },
        { "name": "status", "type": "text", "nullable": false, "default": "'pending'" },
        { "name": "notes", "type": "text", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "timestamp", "nullable": false, "default": "now()" }
      ],
      "indexes": [
        { "name": "payables_status_idx", "columns": ["status"] }
      ]
    }
  }
}
